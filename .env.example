# AfterMeet 环境变量示例。复制为 .env 并填入你自己的密钥。
# 音频始终留在本地,只有「转写后的文字」会发给下面的模型用于生成纪要。

# Gemini API Key(必填,用于生成会议纪要/总结/待办、转写整理、问 AI、会前简报)
# 获取:https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic API Key(可选,无 Gemini 时的降级方案;有 Gemini 可留空)
# 获取:https://console.anthropic.com/
ANTHROPIC_API_KEY=
